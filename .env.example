# =========================================================
# Matrix env template — copy to .env.local on each machine
# =========================================================

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@host/db
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db

# --- AI / LLM (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=
# Default model strings used through the gateway:
#   anthropic/claude-opus-4-7      (synthesis)
#   anthropic/claude-haiku-4-5     (extraction / filtering)

# --- Auth (Clerk) - Machine B only ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments (Stripe) - Machine B only ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Market data providers - Machine A primary ---
# SEC EDGAR requires User-Agent header, not API key
SEC_USER_AGENT="Matrix Research research@example.com"

# Optional free-tier providers
FINNHUB_API_KEY=
POLYGON_API_KEY=

# --- Email / publishing - Machine B ---
RESEND_API_KEY=
