# =========================================================
# Matrix env template — copy to .env.local on each machine
# =========================================================

# --- Database (local Postgres via docker compose) ---
DATABASE_URL=postgres://matrix:matrix_dev_only@localhost:5432/matrix

# --- AI / LLM (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=
# Default model strings used through the gateway:
#   anthropic/claude-opus-4-7      (synthesis)
#   anthropic/claude-haiku-4-5     (extraction / filtering)

# --- Auth (Clerk) - Machine B only ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments (Stripe) - Machine B only ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Exchanges (testnet first; live keys ONLY after Phase 5 gate) ---
# Bybit testnet — https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Bybit mainnet — fill ONLY when Phase 5 risk gates pass
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- News / market data (free tiers) ---
FINNHUB_API_KEY=
POLYGON_API_KEY=

# --- Risk caps (read by execution layer — DO NOT skip) ---
# Hard maximum % of capital per single trade
MAX_POSITION_PCT=2.0
# Daily loss circuit breaker (% of capital). Beyond this all positions close.
DAILY_LOSS_CIRCUIT_PCT=5.0
# Absolute cap on live capital deployed (USD). Anything beyond requires user confirmation.
LIVE_CAPITAL_CAP_USD=2000
# Whether to allow live execution at all. Default: "false". Switch to "true" only after Phase 5 sign-off.
LIVE_EXECUTION_ENABLED=false
