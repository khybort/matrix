# =========================================================
# Matrix env template — copy to .env on each machine
# (gitignored). Compose reads this via docker-compose.yml.
# =========================================================

# --- Database (two-tier) ---
# LOCAL: hot path (market data, raw_documents, AGE graph). Always local.
# SHARED: cold path (predictions, wallet, lab, strategy_configs). Can be Neon.
#
# Single-PC mode: both point to the local Postgres container — identical URLs.
# Multi-PC mode: LOCAL_DATABASE_URL stays local; SHARED_DATABASE_URL points
# to a Neon project URL accessible from all participating PCs.

LOCAL_DATABASE_URL=postgres://matrix:matrix_dev_only@postgres:5432/matrix

# Offline-friendly default: a second local Postgres "postgres-shared"
# stands in for Neon. Brought up by `make up-dev-local`. To use real
# Neon, comment below and uncomment the Neon line.
SHARED_DATABASE_URL=postgres://matrix:matrix_dev_only@postgres-shared:5432/matrix_shared
# SHARED_DATABASE_URL=postgresql://<user>:<pwd>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require

# Convenience: services that haven't been split yet still use DATABASE_URL.
DATABASE_URL=${LOCAL_DATABASE_URL}

# --- Local dev CPU caps (docker-compose.limits.yml; fractional cores) ---
# Defaults: performance profile (heavy 1.0, db 0.75, worker 0.5, light 0.25).
# Tighten if the host struggles: MATRIX_CPU_HEAVY=0.5 MATRIX_CPU_WORKER=0.3
# MATRIX_CPU_SHARED_DB=0.25

# --- Node identity (each PC sets its own) ---
NODE_ID=muhsinkilic-mac-main
NODE_ROLES=dev,ingestion,graph,strategy,backtest,reflection,labs,web

# --- AI / LLM ---
# Backend switch (orthogonal to tier haiku/sonnet):
#   make llm-subscription  → Claude Code OAuth (default)
#   make llm-bedrock       → AWS Bedrock cross-region inference profiles
#   make llm-cursor        → Cursor Auto (model=auto; subscription-style auth)
#   make llm-status        → show active backend
#
# Cursor Auto (`make llm-cursor`):
#   1. Host (recommended): `cursor agent login` once (browser OAuth, like Claude).
#      Matrix calls `cursor agent -p` with model=auto; tier pins are ignored.
#   2. Docker: host login does NOT propagate. CLI is in-image; dev compose
#      persists /root/.cursor on volume matrix_cursor_agent. Once per machine:
#        make cursor-login-docker
#      (or: docker exec -it -e NO_OPEN_BROWSER=1 matrix-agent cursor agent login)
#      Do NOT bind-mount macOS ~/.local/share/cursor-agent (Mach-O vs Linux).
#   3. Optional CI override: CURSOR_API_KEY from Dashboard → Integrations
#
# Claude subscription:
#   CLAUDE_CODE_OAUTH_TOKEN=   from `claude setup-token` on the host
#
AI_GATEWAY_API_KEY=
# Optional; leave empty when using `cursor agent login`
CURSOR_API_KEY=

# --- Risk caps (TRADING.md hard rules — code-enforced) ---
MAX_POSITION_PCT=2.0
DAILY_LOSS_CIRCUIT_PCT=5.0
LIVE_CAPITAL_CAP_USD=2000
# false = dry-run / paper only. true = submit real orders to Bybit (cert + caps still apply).
# Keep BYBIT_TESTNET=true until Phase 5 sign-off; then BYBIT_TESTNET=false + mainnet keys.
LIVE_EXECUTION_ENABLED=false

# --- Paper-trade certificate grant thresholds (optional; unset = TRADING.md defaults) ---
# Dev/testnet example — remove or comment out before mainnet:
# MATRIX_CERT_MIN_OBSERVATION_DAYS=0
# MATRIX_CERT_MIN_OUTCOMES=20
# MATRIX_CERT_MIN_WIN_RATE=0.35
# MATRIX_CERT_MIN_TOTAL_PNL_USD=-50
# MATRIX_CERT_MAX_DRAWDOWN_PCT=0.50

# Mirror paper opens/closes to Bybit when LIVE_EXECUTION_ENABLED=true (paper DB = source of truth).
# MATRIX_EXCHANGE_SHADOW=true

# --- Exchanges ---
BYBIT_TESTNET=true
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- News / market data (free tiers, optional) ---
FINNHUB_API_KEY=
POLYGON_API_KEY=

# --- Web ---
NODE_ENV=development

# --- dev_agent (Phase 0+) ---
# dev_agent's spawned `claude` CLI picks its auth mode from env:
#   - Dev (make up-dev):  Claude Code subscription via CLAUDE_CODE_OAUTH_TOKEN.
#     Generate the token by running `claude setup-token` on the host.
#     docker-compose.dev.yml blanks ANTHROPIC_API_KEY inside the dev_agent
#     container so a prod API key in .env can't accidentally bill you.
#   - Prod (make up-prod): set ANTHROPIC_API_KEY (already declared above).
#     CLAUDE_CODE_OAUTH_TOKEN should be empty in prod.
CLAUDE_CODE_OAUTH_TOKEN=
DEV_AGENT_PARALLEL=2
DEV_AGENT_DAILY_COST_CAP_USD=50
DEV_AGENT_TASK_COST_CAP_USD=5

# --- Notify / Telegram bot (Phase 6) ---
# Bot token from @BotFather. Empty = dry-run (alerts logged, never pushed).
# Allowed chat IDs are a comma-separated list — anything else is ignored.
# Message the bot once with /start; it'll reply with your chat_id even if
# unauthorized, so you can copy it here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Public dashboard (optional; make up-dev-public) ---
# Binds web to 0.0.0.0:3030 — no app auth. Forward TCP 3030 on your router
# to this Mac, or use Cloudflare Tunnel if you are behind CGNAT.
# MATRIX_PUBLIC_WEB_BIND=127.0.0.1:3030   # localhost only (Tailscale serve)
# Free DNS: DuckDNS — https://www.duckdns.org → subdomain + token, then:
#   make duckdns-update && cron */5 * * * * cd .../matrix && ./scripts/duckdns-update.sh -q
# Zero-signup DNS from IP: `make public-ip` → http://<a-b-c-d>.sslip.io:3030
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
