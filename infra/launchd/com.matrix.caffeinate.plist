<?xml version="1.0" encoding="UTF-8"?>
<!-- Keeps the machine awake so the 24/7 decision loops keep running.
     `caffeinate -s` prevents system sleep while on AC power (battery sleep is
     still allowed). Installed to ~/Library/LaunchAgents by `make watchdog-install`. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.matrix.caffeinate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
